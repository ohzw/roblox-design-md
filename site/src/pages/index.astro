---
import { loadCatalog } from "../lib/catalog.mjs";
const entries = loadCatalog();
const tastes = [...new Set(entries.flatMap((e) => e.taste))].sort();
const genres = [...new Set(entries.flatMap((e) => e.genre))].sort();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>DESIGN.roblox.md Catalog</title>
    <style>
      :root {
        --bg: #14151d; --panel: #1e2029; --line: #32354a;
        --text: #e8e6df; --muted: #9a97a8; --accent: #ffd84d;
      }
      * { box-sizing: border-box; margin: 0; }
      body { background: var(--bg); color: var(--text); font: 16px/1.6 system-ui, sans-serif; }
      .wrap { max-width: 1080px; margin: 0 auto; padding: 40px 24px; }
      h1 { font-size: 28px; }
      h1 span { color: var(--accent); }
      .sub { color: var(--muted); margin: 8px 0 28px; }
      .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; }
      .filters .grp { color: var(--muted); font-size: 13px; margin-right: 4px; align-self: center; }
      .tag {
        background: var(--panel); border: 1px solid var(--line); color: var(--text);
        border-radius: 999px; padding: 4px 14px; font-size: 13px; cursor: pointer;
      }
      .tag.on { background: var(--accent); color: #201a05; border-color: var(--accent); }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; margin-top: 24px; }
      .card {
        background: var(--panel); border: 1px solid var(--line); border-radius: 14px;
        overflow: hidden; text-decoration: none; color: inherit; display: flex; flex-direction: column;
        transition: border-color .15s;
      }
      .card:hover { border-color: var(--accent); }
      .thumb { aspect-ratio: 16/9; background: #0d0e13; display: flex; align-items: center; justify-content: center; overflow: hidden; }
      .thumb img { width: 100%; height: 100%; object-fit: cover; }
      .thumb .pending { color: var(--muted); font-size: 13px; }
      .card .meta { padding: 16px; }
      .card h2 { font-size: 18px; }
      .card p { color: var(--muted); font-size: 13px; margin: 6px 0 10px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
      .swatches { display: flex; gap: 4px; margin-bottom: 10px; }
      .swatches i { width: 18px; height: 18px; border-radius: 5px; border: 1px solid #0006; }
      .tags { display: flex; flex-wrap: wrap; gap: 6px; }
      .tags b { font-weight: 500; font-size: 11px; border: 1px solid var(--line); color: var(--muted); border-radius: 999px; padding: 1px 9px; }
      .badge { font-size: 11px; border-radius: 999px; padding: 2px 10px; margin-left: 8px; vertical-align: middle; }
      .badge.ok { background: #2c4a2a; color: #9fe08a; }
      .badge.wip { background: #4a3a2a; color: #e0c08a; }
      footer { margin-top: 48px; color: var(--muted); font-size: 12px; border-top: 1px solid var(--line); padding-top: 16px; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <h1>DESIGN<span>.roblox</span>.md</h1>
      <p class="sub">
        Design systems AI agents can read — for Roblox game UI. Pick a taste,
        copy the file, hand it to your agent. Local MVP (not published).
        <a href="/getting-started/" style="color:var(--accent)">Getting started →</a>
      </p>

      <div class="filters" id="tasteFilters">
        <span class="grp">taste</span>
        {tastes.map((t) => <button class="tag" data-kind="taste" data-v={t}>{t}</button>)}
      </div>
      <div class="filters" id="genreFilters">
        <span class="grp">genre</span>
        {genres.map((g) => <button class="tag" data-kind="genre" data-v={g}>{g}</button>)}
      </div>

      <div class="grid" id="grid">
        {entries.map((e) => (
          <a class="card" href={`/design-md/${e.slug}/`} data-taste={e.taste.join(",")} data-genre={e.genre.join(",")}>
            <div class="thumb">
              {e.previews.length > 0
                ? <img src={`/previews/${e.slug}/${e.previews.includes("hud.png") ? "hud.png" : e.previews[0]}`} alt={`${e.name} preview`} loading="lazy" />
                : <span class="pending">real-device preview pending</span>}
            </div>
            <div class="meta">
              <h2>{e.name}
                {e.previews.length > 0
                  ? <span class="badge ok">verified in-engine</span>
                  : <span class="badge wip">preview pending</span>}
              </h2>
              <p>{e.description}</p>
              <div class="swatches">
                {Object.values(e.colors).slice(0, 8).map((c) => <i style={`background:${String(c).slice(0, 7)}`}></i>)}
              </div>
              <div class="tags">
                {e.taste.map((t) => <b>{t}</b>)}
                {e.genre.map((g) => <b>{g}</b>)}
                <b>{e.componentCount} components</b>
              </div>
            </div>
          </a>
        ))}
      </div>

      <footer>
        Entries are independent analyses of publicly observable UI conventions,
        provided as-is for inspiration. Not affiliated with or endorsed by any
        game or studio.
      </footer>
    </div>

    <script>
      const active = { taste: new Set(), genre: new Set() };
      document.querySelectorAll(".tag").forEach((btn) => {
        btn.addEventListener("click", () => {
          const kind = btn.dataset.kind, v = btn.dataset.v;
          if (active[kind].has(v)) { active[kind].delete(v); btn.classList.remove("on"); }
          else { active[kind].add(v); btn.classList.add("on"); }
          document.querySelectorAll("#grid .card").forEach((card) => {
            const has = (kind) => {
              if (active[kind].size === 0) return true;
              const vals = (card.dataset[kind] || "").split(",");
              return [...active[kind]].some((x) => vals.includes(x));
            };
            card.style.display = has("taste") && has("genre") ? "" : "none";
          });
        });
      });
    </script>
  </body>
</html>
