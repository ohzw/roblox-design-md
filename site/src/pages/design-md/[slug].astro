---
import Base from "../../layouts/Base.astro";
import { loadCatalog } from "../../lib/catalog.mjs";
import { marked } from "marked";

export function getStaticPaths() {
  return loadCatalog().map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const bodyHtml = marked.parse(entry.body);
const rawUrl = `/raw/${entry.slug}.md`;

const heroShot = entry.previews.includes("hud.png") ? "hud.png" : entry.previews[0];
const restShots = entry.previews.filter((p) => p !== heroShot);
const label = (p) => p.replace(/\.(png|jpe?g|webp)$/i, "").replace(/-/g, " ");
---

<Base title={`${entry.name} — DESIGN.roblox.md`} description={entry.description}>
  <article class="wrap entry">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/#catalog">← All tastes</a>
    </nav>

    <header class="entry-head">
      <h1>{entry.name}</h1>
      <p class="desc">{entry.description}</p>
      <div class="tags">
        {entry.previews.length > 0 ? (
          <span class="badge badge-verified">✓ verified in-engine</span>
        ) : (
          <span class="badge badge-pending">preview pending</span>
        )}
        {entry.taste.map((t) => <span class="tagpill">{t}</span>)}
        {entry.genre.map((g) => <span class="tagpill">{g}</span>)}
        <span class="tagpill">{entry.componentCount} components</span>
        {entry.confidence && <span class="tagpill">extracted · confidence declared</span>}
      </div>
    </header>

    <div class="actions-mobile">
      <button class="btn btn-primary copy-btn">Copy DESIGN.roblox.md</button>
      <a class="btn btn-ghost" href={rawUrl} download="DESIGN.roblox.md">Download</a>
    </div>

    <div class="columns">
      <div class="main-col">
        <section aria-labelledby="previews-h">
          <h2 class="sec" id="previews-h">Proof first — real-device captures</h2>
          {entry.previews.length > 0 ? (
            <div class="gallery">
              <figure class="shot lead">
                <img
                  src={`/previews/${entry.slug}/${heroShot}`}
                  alt={`${entry.name} ${label(heroShot)}, captured in Roblox Studio`}
                  width="1280"
                  height="720"
                />
                <figcaption>{label(heroShot)}</figcaption>
              </figure>
              <div class="shot-row">
                {restShots.map((p) => (
                  <figure class="shot">
                    <img
                      src={`/previews/${entry.slug}/${p}`}
                      alt={`${entry.name} ${label(p)}, captured in Roblox Studio`}
                      width="640"
                      height="360"
                      loading="lazy"
                    />
                    <figcaption>{label(p)}</figcaption>
                  </figure>
                ))}
              </div>
            </div>
          ) : (
            <p class="pending-box">
              No real-device previews yet — this entry hasn't passed the
              screenshot stage of the pipeline. Policy: no in-engine proof, no
              publication.
            </p>
          )}
        </section>

        <section aria-labelledby="doc-h">
          <h2 class="sec" id="doc-h">The document</h2>
          <div class="doc" set:html={bodyHtml} />
        </section>
      </div>

      <aside class="side-col">
        <div class="take-it">
          <h2 class="sec take-h">Take it home</h2>
          <button class="btn btn-primary take-btn copy-btn">
            Copy DESIGN.roblox.md
          </button>
          <div class="take-alt">
            <a class="btn btn-ghost" href={rawUrl} download="DESIGN.roblox.md">Download</a>
            <a class="btn btn-ghost" href={rawUrl}>Raw</a>
          </div>
          <ol class="use-steps">
            <li>Drop the file in your project root.</li>
            <li>Give your agent the <code>designmd-to-react-lua</code> skill.</li>
            <li>Prompt: <em>“Using DESIGN.roblox.md, build the HUD and shop.”</em></li>
          </ol>
          <p class="use-more">
            Full walkthrough in <a href="/getting-started/">Getting started</a>.
            Every entry lints clean against the spec before it ships.
          </p>
        </div>

        <div class="palette">
          <h2 class="sec">Palette</h2>
          <ul class="swatch-list">
            {Object.entries(entry.colors).map(([name, val]) => (
              <li>
                <i style={`background:${String(val).slice(0, 7)}`}></i>
                <span class="sw-name">{name}</span>
                <code class="sw-val">{String(val)}</code>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </article>
</Base>

<style>
  .entry { padding-top: var(--space-xl); }
  .crumb a {
    color: var(--muted);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .crumb a:hover { color: var(--crimson); }

  .entry-head { margin-top: var(--space-md); max-width: 72ch; }
  .entry-head h1 { font-size: var(--text-2xl); letter-spacing: -0.02em; }
  .entry-head .desc {
    margin-top: var(--space-sm);
    color: var(--muted);
    font-size: var(--text-lg);
    line-height: 1.5;
    max-width: 58ch;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-md);
  }

  /* on narrow screens the sidebar sinks below the long document, so the
     copy action gets its own row right under the header */
  .actions-mobile {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-lg);
  }
  @media (min-width: 900px) {
    .actions-mobile { display: none; }
  }

  .columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2xl);
    margin-top: var(--space-2xl);
  }
  @media (min-width: 900px) {
    .columns { grid-template-columns: minmax(0, 1fr) 320px; align-items: start; }
    .side-col { position: sticky; top: var(--space-lg); }
  }

  .sec {
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-md);
  }
  .sec::after {
    content: "";
    display: block;
    width: 2.25rem;
    height: 3px;
    border-radius: 2px;
    background: var(--crimson);
    margin-top: var(--space-2xs);
  }
  .main-col section + section { margin-top: var(--space-3xl); }

  /* --- previews --- */
  .shot {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .shot img { width: 100%; height: auto; }
  .shot figcaption {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
    padding: var(--space-xs) var(--space-sm);
    border-top: 1px solid var(--line);
  }
  .shot-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-md);
    align-items: start; /* captures have mixed aspect ratios; don't stretch frames */
  }
  .pending-box {
    color: var(--muted);
    background: var(--surface);
    border: 1.5px dashed var(--line-strong);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    max-width: 58ch;
  }

  /* --- document --- */
  .doc {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 1rem + 2vw, 2.5rem);
    overflow-x: auto;
  }
  .doc :global(h1) { font-size: var(--text-xl); margin-bottom: var(--space-md); }
  .doc :global(h2) {
    font-size: var(--text-lg);
    margin: var(--space-xl) 0 var(--space-sm);
    padding-bottom: var(--space-2xs);
    border-bottom: 2px solid var(--crimson-wash);
  }
  .doc :global(h3) { font-size: var(--text-base); margin: var(--space-lg) 0 var(--space-xs); }
  .doc :global(p), .doc :global(li) { font-size: var(--text-sm); line-height: 1.7; max-width: 70ch; }
  .doc :global(ul), .doc :global(ol) { padding-left: 1.375rem; margin: var(--space-sm) 0; }
  .doc :global(code) {
    background: var(--surface);
    border-radius: 5px;
    padding: 0.1em 0.4em;
    font-size: 0.8125em;
  }
  .doc :global(pre) {
    background: var(--code-bg);
    color: var(--code-ink);
    border-radius: var(--radius-sm);
    padding: var(--space-md);
    overflow-x: auto;
    margin: var(--space-sm) 0;
  }
  .doc :global(pre code) { background: none; padding: 0; font-size: var(--text-xs); line-height: 1.6; }
  .doc :global(table) { border-collapse: collapse; font-size: var(--text-sm); margin: var(--space-sm) 0; }
  .doc :global(th), .doc :global(td) { border: 1px solid var(--line); padding: 0.375rem 0.75rem; text-align: left; }
  .doc :global(blockquote) {
    background: var(--crimson-wash);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: var(--space-sm) var(--space-md);
    margin: var(--space-sm) 0;
  }

  /* --- aside --- */
  .take-it, .palette {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    box-shadow: var(--shadow-md);
  }
  .palette { margin-top: var(--space-lg); }

  .take-btn { width: 100%; justify-content: center; font-size: var(--text-base); }
  .copy-btn.done { background: var(--verified); }
  .take-alt {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
  }
  .take-alt .btn { justify-content: center; background: var(--bg); }

  .use-steps {
    margin: var(--space-lg) 0 0;
    padding-left: 1.25rem;
    font-size: var(--text-sm);
    line-height: 1.6;
    display: grid;
    gap: var(--space-xs);
  }
  .use-steps li::marker { color: var(--crimson); font-weight: 700; }
  .use-steps code { background: var(--bg); border-radius: 5px; padding: 0.1em 0.4em; font-size: 0.8125em; }
  .use-more {
    margin-top: var(--space-md);
    font-size: var(--text-xs);
    color: var(--muted);
    line-height: 1.7;
  }

  .swatch-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-xs);
  }
  .swatch-list li {
    display: grid;
    grid-template-columns: 28px 1fr;
    grid-template-rows: auto auto;
    column-gap: var(--space-sm);
    align-items: center;
  }
  .swatch-list i {
    grid-row: span 2;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    border: 1px solid oklch(24.5% 0.02 31 / 0.25);
  }
  .sw-name { font-size: var(--text-sm); font-weight: 600; line-height: 1.3; }
  .sw-val { font-size: var(--text-xs); color: var(--muted); word-break: break-all; }
</style>

<script define:vars={{ rawUrl }}>
  document.querySelectorAll(".copy-btn").forEach((btn) => {
    const idle = btn.textContent.trim();
    btn.addEventListener("click", async () => {
      try {
        const res = await fetch(rawUrl);
        await navigator.clipboard.writeText(await res.text());
        btn.textContent = "Copied — go build ✓";
        btn.classList.add("done");
      } catch {
        btn.textContent = "Copy failed — try Download";
      }
      setTimeout(() => {
        btn.textContent = idle;
        btn.classList.remove("done");
      }, 2000);
    });
  });
</script>
